{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaspweowaale/universal-appliance-local-control/schemas/plugin_manifest.schema.json",
  "title": "UALC plugin manifest",
  "description": "Manifest for a Level-2 community adapter (Lua in API version 1.0). Language-neutral: a plugin in another language speaking the same NDJSON contract would use the same manifest. Full wire contract: docs/PLUGIN_MANIFEST_SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "plugin", "requires", "supports",
               "operations", "capabilities", "authentication", "permissions",
               "support_status", "enabled_by_default"],
  "properties": {
    "manifest_version": {"const": "1.0"},

    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "language", "entrypoint",
                   "maintainers", "license", "source_provenance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
          "description": "Stable dotted lowercase identifier: <vendor>.<family>.<model>."
        },
        "name": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "language": {
          "enum": ["lua"],
          "description": "Lua is the only executable plugin language in API version 1.0."
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$",
          "description": "Path relative to the manifest. No absolute paths, no '..'."
        },
        "maintainers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "description": "Who to ask when an appliance misbehaves."
        },
        "license": {
          "type": "string",
          "description": "Must be MIT-compatible. UALC is MIT; GPL-derived plugins cannot be merged."
        },
        "source_provenance": {
          "type": "string",
          "minLength": 1,
          "description": "Where the protocol knowledge came from. If it derives from another project's work, say so here and in the pull request."
        }
      }
    },

    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_ualc_api_version"],
      "properties": {
        "min_ualc_api_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "max_ualc_api_version": {"type": "string", "pattern": "^[0-9]+\\.([0-9]+|x)$"},
        "lua_version": {"type": "string", "description": "e.g. '5.4+'"}
      }
    },

    "supports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturers", "protocol_families", "models"],
      "properties": {
        "manufacturers": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        },
        "protocol_families": {
          "type": "array", "minItems": 1, "items": {"type": "string"}
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["model_id", "device_class"],
            "properties": {
              "model_id": {"type": "string", "minLength": 1},
              "marketing_names": {"type": "array", "items": {"type": "string"}},
              "device_class": {
                "enum": ["air_purifier", "air_conditioner", "refrigerator",
                         "vacuum", "washer", "dryer", "dishwasher",
                         "water_heater", "dehumidifier", "oven", "other"]
              },
              "firmware_ranges": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Firmware actually observed. Empty means UNKNOWN, not ALL."
              },
              "notes": {"type": "string"}
            }
          },
          "description": "Claim only models you observed. A shared model id, chipset or cloud platform is not evidence of a shared local protocol."
        }
      }
    },

    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["describe", "identify", "parse_inbound", "decode_state",
                 "describe_controls", "supported_commands",
                 "validate_command", "build_outbound", "is_ack_for"]
      },
      "description": "Must match what describe() returns. A partial set is normal and correct: a plugin declares its surface rather than assuming every appliance exposes the same operations."
    },

    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": {"type": "array", "items": {"type": "string"}},
        "write": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Empty for a decoder-only plugin, which is a legitimate and common case."
        },
        "partial_state_updates": {"type": "boolean"},
        "reports_incompatibility": {"type": "boolean"}
      }
    },

    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "handled_by", "plugin_receives_credentials"],
      "properties": {
        "required": {"type": "boolean"},
        "handled_by": {"const": "ualc_core"},
        "plugin_receives_credentials": {
          "const": false,
          "description": "Must be false. There is no mechanism to set it true: the wire contract has no credential field and the host refuses to forward credential-shaped keys."
        }
      }
    },

    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network", "subprocess", "environment"],
      "properties": {
        "filesystem": {"const": "none"},
        "network": {"const": "none"},
        "subprocess": {"const": "none"},
        "environment": {"const": "none"}
      },
      "description": "All must be 'none' in API version 1.0 — the sandbox provides no mechanism to grant any of them. They are declared explicitly so a plugin that wants more is visibly asking."
    },

    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional overrides of host defaults. A reviewer may raise these; a plugin can never raise its own at runtime.",
      "properties": {
        "cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "address_space_bytes": {"type": "integer", "minimum": 16777216},
        "open_files": {"type": "integer", "minimum": 4, "maximum": 256},
        "request_timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 60},
        "max_response_bytes": {"type": "integer", "minimum": 1024}
      }
    },

    "support_status": {
      "type": "object",
      "required": ["level", "verification_source", "hardware_tested"],
      "properties": {
        "level": {
          "enum": ["RESEARCH", "CAPTURED", "DECODED", "SIMULATED",
                   "COMMUNITY_HARDWARE_TESTED", "MAINTAINER_HARDWARE_TESTED",
                   "LOCAL_OPERATIONAL", "CLOUD_INDEPENDENT"]
        },
        "verification_source": {"enum": ["none", "community", "maintainer", "both"]},
        "hardware_tested": {"type": "boolean"},
        "fixtures": {
          "enum": ["synthetic", "captured", "mixed"],
          "description": "Synthetic fixtures prove the decoder is self-consistent. Only captured frames support CAPTURED or above."
        },
        "known_limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "enum": ["COMMUNITY_HARDWARE_TESTED", "MAINTAINER_HARDWARE_TESTED",
                         "LOCAL_OPERATIONAL", "CLOUD_INDEPENDENT"]
              }
            },
            "required": ["level"]
          },
          "then": {"properties": {"hardware_tested": {"const": true}}}
        },
        {
          "if": {
            "properties": {"level": {"const": "MAINTAINER_HARDWARE_TESTED"}},
            "required": ["level"]
          },
          "then": {"properties": {"verification_source": {"enum": ["maintainer", "both"]}}}
        },
        {
          "if": {
            "properties": {"level": {"const": "COMMUNITY_HARDWARE_TESTED"}},
            "required": ["level"]
          },
          "then": {"properties": {"verification_source": {"enum": ["community", "both"]}}}
        }
      ]
    },

    "enabled_by_default": {
      "const": false,
      "description": "Community plugins ship disabled. An operator enables one deliberately."
    }
  }
}
